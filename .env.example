# Скопируйте этот файл в .env и впишите ключ. Файл .env в git не попадает.

# --- Google Gemini (по умолчанию, бесплатный тариф): https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Или OpenAI / любой OpenAI-совместимый API (OpenRouter, vLLM, LM Studio) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Или Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Или локальная модель через Ollama (без ключа) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- Тонкая настройка (необязательно) ---
# LLM_TEMPERATURE=0          # по умолчанию 0 (для Gemini 3.x — 1.0, как рекомендует Google)
# LLM_MIN_INTERVAL=4         # пауза между запросами, с (бесплатный тариф Gemini)
# AGENT_BATCH_SIZE=8         # сколько требований проверять за один запрос
